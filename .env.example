# Required: secret API key for bot authentication
API_KEY=change-me-to-a-long-random-string

# Optional: server bind address (defaults shown)
PORT=5000
HOST=0.0.0.0
STATE_FILE=data/dashboard_state.json
RATE_LIMIT_MAX_REQUESTS=600

# Optional reliable server-side Telegram alerts. Create the bot with @BotFather,
# send it /start once, then set the direct-chat numeric ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_STATE_FILE=data/telegram_alert_state.json
