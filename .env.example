# Required in production: shared secret presented by reporting bots as
# X-API-Key. Generate a long random value; never reuse a wallet private key.
API_KEY=change-me-to-a-long-random-string

# Server bind settings. Use HOST=127.0.0.1 behind nginx/Caddy; 0.0.0.0 exposes
# Flask/Gunicorn on every interface and should be protected by a firewall.
PORT=5000
HOST=0.0.0.0
# Durable latest bot states and bounded history. Relative paths resolve from the
# dashboard working directory. Writes are coalesced at the interval below.
STATE_FILE=data/dashboard_state.json
STATE_FLUSH_INTERVAL=15
# Authenticated status writes allowed per source IP per rolling minute. Size
# this above total fleet reports/minute, especially when bots share one NAT IP.
RATE_LIMIT_MAX_REQUESTS=600

# Optional reliable server-side Telegram alerts. Create the bot with @BotFather,
# send it /start once, then set the direct-chat numeric ID. Telegram remains
# disabled unless both values are non-empty; only that direct chat is accepted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Stores command offset, alert dedupe, preferences, mute, and digest state.
TELEGRAM_ALERT_STATE_FILE=data/telegram_alert_state.json
# Low ETH triggers at each bot's gas reserve plus this non-negative buffer.
TELEGRAM_LOW_FUNDS_BUFFER_ETH=0.0005
# Wallet USDG balance triggering an unbanked-funds alert. Set 0 to disable;
# after firing, the alert re-arms below half the configured threshold.
TELEGRAM_UNBANKED_USDG_THRESHOLD=10
# Daily digest time in UTC, strict HH:MM. Comment out or leave blank to disable
# scheduled delivery while keeping the on-demand /digest command available.
TELEGRAM_DAILY_DIGEST_TIME=13:00
DOOM_SCOUT_STATE_FILE=data/doom_scout.json
DOOM_SCOUT_INTERVAL_SECONDS=900
UNISWAP_API_KEY=
